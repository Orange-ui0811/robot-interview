Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.25
      Plane Cell Count: 40
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/RobotModel
      Name: Go1
      Enabled: true
      Description Source: Topic
      Description Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Arrows: false
      Show Axes: true
      Show Names: false
      Marker Scale: 0.2
    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Enabled: true
      Keep: 1
      Topic:
        Value: /odom
      Shape:
        Value: Arrow
        Shaft Length: 0.18
        Shaft Radius: 0.015
        Head Length: 0.06
        Head Radius: 0.035
      Covariance:
        Value: false
    - Class: rviz_default_plugins/Path
      Name: Path
      Enabled: true
      Topic:
        Value: /go1/path
      Color: 34; 186; 216
      Line Style: Billboards
      Line Width: 0.015
  Enabled: true
  Global Options:
    Background Color: 39; 46; 56
    Fixed Frame: odom
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Target Frame: <Fixed Frame>
      Distance: 2.3
      Pitch: 0.55
      Yaw: 0.85
      Focal Point:
        X: 0.35
        Y: 0
        Z: 0.25
Window Geometry:
  Height: 820
  Width: 1240
